{
  "name": "gc-rep-fe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "gc-rep-fe",
  "sourceRoot": "apps/gc-rep-fe/src",
  "tags": ["scope: front-end", "type: app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/gc-rep-fe",
        "index": "apps/gc-rep-fe/src/index.html",
        "browser": "apps/gc-rep-fe/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/gc-rep-fe/tsconfig.app.json",
        "inlineStyleLanguage": "css",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/gc-rep-fe/public"
          }
        ],
        "styles": ["apps/gc-rep-fe/src/styles.css"],
        "scripts": [
          "node_modules/flowbite/dist/flowbite.min.js",
          "node_modules/flowbite-datepicker/dist/js/datepicker-full.min.js"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "local": {
          "outputPath": "apps/gc-rep-fe/dist/gc-rep-fe-local",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "gc-rep-fe:build:production"
        },
        "development": {
          "buildTarget": "gc-rep-fe:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/gc-rep-fe/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "gc-rep-fe:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/gc-rep-fe/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "gc-rep-fe:build",
        "port": 4200,
        "staticFilePath": "dist/apps/gc-rep-fe/browser",
        "spa": true
      }
    },
    "docker-build": {
      "dependsOn": ["build"],
      "command": "docker build -f apps/gc-rep-fe/Dockerfile . -t gc-rep-fe"
    }
  }
}
